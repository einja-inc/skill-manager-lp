{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    },
    "Figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "headers": {}
    },
    "codex": {
      "type": "stdio",
      "command": "codex",
      "args": [
        "mcp-server"
      ],
      "env": {}
    },
    "ptengine": {
      "type": "http",
      "url": "https://mcp.ptengine.com/mcp",
      "headers": {
        "X-API-KEY": "${PTENGINE_API_KEY}"
      }
    },
    "ahrefs": {
      "type": "http",
      "url": "https://api.ahrefs.com/mcp/mcp",
      "headers": {
        "Authorization": "Bearer ${AHREFS_API_KEY}"
      }
    },
    "mfc_ca": {
      "type": "http",
      "url": "https://beta.mcp.developers.biz.moneyforward.com/mcp/ca/v3",
      "headers": {}
    },
    "FigmaEdit": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "headers": {}
    },
    "doop": {
      "type": "http",
      "url": "https://doop.einja.net/mcp",
      "headers": {}
    },
    "plane": {
      "type": "http",
      "url": "https://eenchow-task-force.einja.net/mcp",
      "headers": {}
    }
  }
}
